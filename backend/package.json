{
  "name": "kalptaru-yog-vidyalaya-backend",
  "version": "1.0.0",
  "description": "Production Backend API for Kalptaru Yog Vidyalaya",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "yoga",
    "express",
    "typescript",
    "mongodb",
    "supabase"
  ],
